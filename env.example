# =============================================================================
# RASI - Report Analisis Saham Indonesia
# Environment Variables Configuration
# =============================================================================
# Salin file ini menjadi .env.local sebelum menjalankan aplikasi:
#   cp env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# URL koneksi ke PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rasi"

# -----------------------------------------------------------------------------
# SECTORS API
# -----------------------------------------------------------------------------
# API Key dari Sectors Financial API (https://sectors.app)
# Digunakan untuk mengambil data fundamental perusahaan IDX (harga, valuasi, laporan keuangan).
# Dapatkan API Key di: https://sectors.app/api
SECTORS_API_KEY="your_sectors_api_key_here"
 
# -----------------------------------------------------------------------------
# GOOGLE GEMINI API (Opsional / Gratis)
# -----------------------------------------------------------------------------
# Digunakan untuk analisis sentimen & dampak berita real-time (Unpriced Catalyst).
# Gratis tanpa kartu kredit: https://aistudio.google.com/
# Jika kosong, sistem otomatis memakai rule-based sentiment fallback.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3-flash-preview"

# -----------------------------------------------------------------------------
# BETTER AUTH + GOOGLE OAUTH
# -----------------------------------------------------------------------------
# Generate a random secret of at least 32 characters for production.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# -----------------------------------------------------------------------------
# SIGNAL ANALYSIS & INTRADAY PROVIDER
# -----------------------------------------------------------------------------
# Mengaktifkan mesin evaluasi sinyal intraday baru
SIGNAL_ANALYSIS_ENABLED=false
# Provider intraday: 'yahoo' (feed chart 5m tertunda ~10 menit untuk BEI)
INTRADAY_PROVIDER=yahoo

