# =============================================================================
# RASI - Report Analisis Saham Indonesia
# Environment Variables Configuration
# =============================================================================
# Salin file ini menjadi .env.local sebelum menjalankan aplikasi:
#   cp env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# URL koneksi ke PostgreSQL database runtime aplikasi.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rasi"

# URL koneksi khusus migrasi (opsional, disarankan dengan izin DDL terpisah).
DATABASE_MIGRATION_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rasi"

# -----------------------------------------------------------------------------
# FEATURE FLAGS (SERVER BOUNDARY ENFORCEMENT)
# -----------------------------------------------------------------------------
# Mengaktifkan analisis mendalam & integrasi Sectors API
RASI_ANALYSIS_ENABLED=false

# Mengaktifkan asisten percakapan cerdas dengan Google Gemini
RASI_ASSISTANT_ENABLED=false

# Mengaktifkan mesin evaluasi sinyal intraday & Monte Carlo
SIGNAL_ANALYSIS_ENABLED=false

# -----------------------------------------------------------------------------
# SECTORS API & BUDGET GUARD
# -----------------------------------------------------------------------------
# API Key dari Sectors Financial API (https://sectors.app/api)
SECTORS_API_KEY="your_sectors_api_key_here"

# Batas kuota kredit harian Sectors (wajib > 0 jika RASI_ANALYSIS_ENABLED=true di produksi)
SECTORS_DAILY_CREDIT_BUDGET=500

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI
# -----------------------------------------------------------------------------
# API Key Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Model Gemini stabil (allowlist ketat: gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Batas kuota harian pemanggilan Gemini (wajib > 0 jika RASI_ASSISTANT_ENABLED=true di produksi)
GEMINI_DAILY_REQUEST_BUDGET=1500

# -----------------------------------------------------------------------------
# BETTER AUTH + GOOGLE OAUTH
# -----------------------------------------------------------------------------
# Secret sesi minimal 32 karakter (wajib diganti di produksi)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# URL basis aplikasi (wajib HTTPS di produksi)
BETTER_AUTH_URL="http://localhost:3000"

# Kredensial OAuth Google
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# -----------------------------------------------------------------------------
# SIGNAL ANALYSIS, INTRADAY PROVIDER & SIMULATION LIMITS
# -----------------------------------------------------------------------------
# Provider data intraday: 'yahoo'
INTRADAY_PROVIDER="yahoo"

# Batas maksimal jalur Monte Carlo sinkron (default: 25000)
SIMULATION_MAX_PATHS=25000

# Batas waktu tunggu provider eksternal dalam milidetik (default: 10000)
PROVIDER_TIMEOUT_MS=10000

# Waktu simpan cache dalam detik (default: 300)
CACHE_TTL_SECONDS=300
